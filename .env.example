# =============================================================
# Kortex AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.
# =============================================================

# ----- AI API Keys (at least one is required) ----------------
# Gemini is used by the frontend and as a fallback in the backend.
# Get your key at: https://aistudio.google.com/app/apikey
# In Google AI Studio this is injected automatically via the Secrets panel.
GEMINI_API_KEY=""

# DeepSeek is the primary AI provider used by the backend server.
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# ----- App URL -----------------------------------------------
# The URL where this app is hosted.
# Google AI Studio injects this automatically at runtime.
# For local dev you can leave it blank or set to http://localhost:5000
APP_URL="MY_APP_URL"

# ----- Server Config (optional) ------------------------------
# Port the Express server listens on. Defaults to 5000.
PORT=5000

# Set to "production" when running a built/deployed version.
NODE_ENV=development

# ----- Firebase (managed via firebase-applet-config.json) ----
# Firebase credentials are stored in firebase-applet-config.json
# in the project root. Do NOT move them here — Firebase reads
# that file directly. Update that file if you change Firebase projects.
